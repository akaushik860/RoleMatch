# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Any current Gemini model name.
GEMINI_MODEL=gemini-3.8-flash
# Optional. Tried in order when the main model is busy or slow.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# Optional. Thinking level for Gemini 3 models: low (fast, default), medium, high.
GEMINI_THINKING=low
# Set to 1 to fake AI responses for local testing without a key.
AI_MOCK=

# Supabase (sign-in + saved resumes). Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
